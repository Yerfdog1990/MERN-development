# Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging (error|warn|info|http|debug) — defaults: debug in dev, info in prod
LOG_LEVEL=debug

# Auth
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# Uploads
MAX_FILE_SIZE_BYTES=5242880

# Email (leave SMTP_* unset in development to use Ethereal fake SMTP
# — emails are captured, never delivered, preview URL is logged)
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=your-email@gmail.com
#SMTP_PASS=your-app-password
EMAIL_FROM="Tour & Travel <noreply@tourtravel.example>"
